# URL base de la API del modelo (ej. https://api.midominio.com).
# Si se deja vacía, el frontend usa el dataset de muestra local (modo demo).
VITE_API_URL=

# Opcional: token Bearer para la API del modelo.
# Ojo: en una SPA esta variable queda expuesta en el bundle. Úsala solo en
# entornos de hackatón/demo, no con credenciales reales de producción.
VITE_API_KEY=
