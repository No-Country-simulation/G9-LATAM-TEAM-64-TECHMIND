# Credenciales de la base de datos.
#
# Copia este archivo a `.env` en la raíz del repositorio y pon valores reales.
# `.env` NO debe subirse a git.
#
# Docker Compose los lee automáticamente y los inyecta en los contenedores de
# postgres y backend.

POSTGRES_DB=techmind_db
POSTGRES_USER=techmind
POSTGRES_PASSWORD=cambia-esta-contrasena
